generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ORGANIZER
  ATTENDEE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ATTENDEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    Event[]  @relation("OrganizerEvents")
  bookings  Booking[]

  @@index([role])
}

model Event {
  id             String      @id @default(uuid())
  title          String
  description    String
  location       String
  startsAt       DateTime
  ticketPrice    Int         @default(0) // store price in smallest unit if paid later
  totalSeats     Int
  remainingSeats Int
  status         EventStatus @default(DRAFT)

  organizerId    String
  organizer      User        @relation("OrganizerEvents", fields: [organizerId], references: [id])

  bookings       Booking[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([startsAt])
  @@index([location])
  @@index([status])
}

model Booking {
  id         String        @id @default(uuid())
  userId     String
  eventId    String
  quantity   Int
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  user       User          @relation(fields: [userId], references: [id])
  event      Event         @relation(fields: [eventId], references: [id])

  // Prevent "a user cannot book the same event twice"
  @@unique([userId, eventId])
  @@index([eventId])
}
